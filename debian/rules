#!/usr/bin/make -f
export PYBUILD_NAME = neo_code
export PYBUILD_DESTDIR = debian/neo-code
# No test suite ships in the package build; run tooling via `make lint`, not here.
export PYBUILD_DISABLE = test

%:
	dh $@ --with python3 --buildsystem=pybuild

# The app icon installs into the hicolor theme via debian/install, matching the
# .desktop file's themed name "neo-code". Master artwork lives at
# src/neo_code/resources/icons/neo-code.svg; regenerate the PNGs with
# scripts/render_icon.py (the build container has no rasteriser, so they ship
# pre-rendered).
